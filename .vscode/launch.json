{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: debug a built program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${input:cppProgram}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Python: debug current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "cppProgram",
      "type": "promptString",
      "description": "Absolute WSL path to the built ELF executable"
    }
  ]
}
